<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.fondos" path="/org/gnome/shell/extensions/fondos/">
    <key name="auto" type="b">
      <default>true</default>
      <summary>Cambiar el fondo cada 30 minutos</summary>
    </key>
    <key name="fuente" type="s">
      <choices>
        <choice value="ambas"/>
        <choice value="wallhaven"/>
        <choice value="generados"/>
      </choices>
      <default>'ambas'</default>
      <summary>De dónde salen los fondos: Wallhaven, generados o ambas</summary>
    </key>
    <key name="ultimo-cambio" type="x">
      <default>0</default>
      <summary>Hora del último cambio automático (segundos Unix)</summary>
    </key>
    <key name="estado" type="s">
      <default>''</default>
      <summary>Fotos del fondo actual y acomodo de pantallas (JSON)</summary>
    </key>
  </schema>
</schemalist>
